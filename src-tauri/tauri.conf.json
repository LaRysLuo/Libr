{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Libr",
  "version": "0.1.1",
  "identifier": "app.libr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' libr: http://libr.localhost; img-src 'self' libr: http://libr.localhost data: blob: https://images.unsplash.com; media-src 'self' libr: http://libr.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com"
    },
    "windows": [
      {
        "label": "main",
        "title": "Libr 资源库",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "把所有资源收进一个可携带的 .libr 文件",
    "longDescription": "Libr 是一个面向 Windows 和 macOS 的本地优先数字资源管理工具。",
    "fileAssociations": [
      {
        "ext": ["libr"],
        "name": "Libr 资源库",
        "description": "Libr 单文件资源库",
        "role": "Editor",
        "mimeType": "application/x-libr"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NDc1MUM5QjRGNTdCRkIKUldUN2UvVzB5VkZIaDlTdUR2SVlhVEE5N0pRZDdvT2xRcUdJVDYybVNHazZnaTZCQ3lTdVp1UFQK",
      "endpoints": [
        "https://github.com/LaRysLuo/Libr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
